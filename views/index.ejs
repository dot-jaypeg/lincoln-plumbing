<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body class="page-home">
<%- include('partials/header') %>

<main>
  <section class="hero">
    <div class="hero-media">
      <video class="hero-video" autoplay muted loop playsinline poster="/images/hero-poster.jpg?v=<%= v %>">
        <source src="/video/hero-loop.webm?v=<%= v %>" type="video/webm">
        <source src="/video/hero-loop.mp4?v=<%= v %>" type="video/mp4">
      </video>
      <div class="hero-overlay"></div>
    </div>
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge"><span class="dot"></span> 24/7 Emergency Service &middot; Inland Empire</span>
        <h1>Fast, Honest Plumbing You Can Actually Trust</h1>
        <p class="lede">Family-owned since 2021, backed by two decades of hands-on experience. Licensed, insured, and ready around the clock for anything from a slow drain to a full repipe.</p>
        <div class="hero-ctas">
          <a href="<%= site.phoneHref %>" class="btn btn-primary">24/7 Emergency Service — Call Now</a>
          <a href="/contact" class="btn btn-secondary">Book a Free Estimate</a>
        </div>
        <div class="promo-strip">
          <div class="promo-chip">
            <span class="price">$80</span>
            <span class="label">Drain Cleaning Special<small>Regularly priced higher</small></span>
          </div>
          <div class="promo-chip">
            <span class="price">$80</span>
            <span class="label">Water Heater Maintenance<small>Flush, inspect & tune-up</small></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/trust-bar') %>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">What We Do</span>
        <h2>Core Plumbing Services</h2>
        <p>From everyday repairs to full sewer line replacements, our licensed technicians handle it right the first time — residential and commercial.</p>
      </div>
      <div class="services-grid">
        <% services.forEach(function(service) { %>
        <div class="service-card">
          <div class="service-icon"><%- icons[service.icon] %></div>
          <h3><%= service.title %></h3>
          <p><%= service.short %></p>
          <a class="service-link" href="/services#<%= service.slug %>">Learn more &rarr;</a>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <div class="story">
        <div class="story-media">
          <img src="/images/team-two-techs.jpg" alt="Two Lincoln Plumbing & Rooter technicians standing in front of a company van">
          <div class="story-badge"><strong>2021</strong><span>Company Founded</span></div>
        </div>
        <div class="story-copy">
          <span class="eyebrow blue">Our Story</span>
          <h2>Two Brothers, One Simple Mission</h2>
          <p>Founded by two brothers with a simple mission: to provide honest, high-quality plumbing services that customers can trust. From fixing leaky faucets to tackling major pipe replacements, we treat every job with the same level of care.</p>
          <p>We've built a reputation for reliability, transparency, and quality craftsmanship — backed by two decades of hands-on experience across the Inland Empire.</p>
          <div class="story-signoff">
            <a href="/about" class="btn btn-outline">Read Our Full Story &rarr;</a>
          </div>
        </div>
      </div>

      <div class="usp-row">
        <div class="usp-item"><strong>20+</strong><span>Years Hands-On Experience</span></div>
        <div class="usp-item"><strong>24/7</strong><span>Emergency Availability</span></div>
        <div class="usp-item"><strong>100%</strong><span>Family Owned & Operated</span></div>
        <div class="usp-item"><strong>Free</strong><span>In-Person Estimates</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Reputation</span>
        <h2>Rated 5 Stars Across the Inland Empire</h2>
        <p>Don't just take our word for it — see what neighbors across San Bernardino, Riverside, and Fontana are saying.</p>
      </div>
      <div class="testimonial-grid">
        <a href="<%= site.social.google %>" target="_blank" rel="noopener" class="testimonial-card" style="text-decoration:none;">
          <div class="stars">★★★★★</div>
          <h3 style="font-size:1.1rem;">Google Reviews</h3>
          <p style="margin-top:8px;">Read verified reviews from real customers across the Inland Empire.</p>
          <div class="testimonial-author"><span class="service-link">See our reviews &rarr;</span></div>
        </a>
        <a href="<%= site.social.yelp %>" target="_blank" rel="noopener" class="testimonial-card" style="text-decoration:none;">
          <div class="stars">★★★★★</div>
          <h3 style="font-size:1.1rem;">Yelp</h3>
          <p style="margin-top:8px;">Honest feedback from homeowners and businesses we've served.</p>
          <div class="testimonial-author"><span class="service-link">See our reviews &rarr;</span></div>
        </a>
        <div class="testimonial-card">
          <div class="stars">★★★★★</div>
          <h3 style="font-size:1.1rem;">Thumbtack</h3>
          <p style="margin-top:8px;">Top-rated for responsiveness, pricing, and quality of work.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow blue">From the Blog</span>
        <h2>Plumbing Tips & News</h2>
        <p>Guides and insight from our own licensed technicians, written for Inland Empire homeowners and businesses.</p>
      </div>
      <div class="blog-grid">
        <% recentPosts.forEach(function(post) { %>
        <a class="blog-card" href="/blog/<%= post.slug %>">
          <div class="blog-card-media"><img src="/images/<%= post.image %>" alt="<%= post.title %>"></div>
          <div class="blog-card-body">
            <span class="blog-date"><%= new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
            <h3><%= post.title %></h3>
            <p><%= post.excerpt %></p>
            <span class="read-more">Read More &rarr;</span>
          </div>
        </a>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Have a plumbing problem right now?</h2>
          <p>Our team is on call 24/7 across the Inland Empire — call now or book a free in-person estimate.</p>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <a href="<%= site.phoneHref %>" class="btn btn-primary">Call <%= site.phone %></a>
          <a href="/contact" class="btn btn-outline" style="border-color:rgba(255,255,255,0.5); color:#fff;">Free Estimate</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
