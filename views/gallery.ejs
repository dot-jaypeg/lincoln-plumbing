<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>
  <section class="section-tight bg-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Photo Gallery</span>
        <h2>Real Jobs, Real Trucks, Real Team</h2>
        <p>No stock photos here — this is our crew, our vans, and the everyday work we do across the Inland Empire.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:56px;">
    <div class="container">
      <div class="gallery-grid">
        <% gallery.forEach(function(item) { %>
        <div class="gallery-item <%= item.size %>">
          <img src="/images/<%= item.src %>" alt="<%= item.alt %>" loading="lazy">
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Want to see us in action?</h2>
          <p>Follow along on Instagram and TikTok, or better yet — book a free estimate and meet the crew.</p>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <a href="<%= site.social.instagram %>" target="_blank" rel="noopener" class="btn btn-primary">Follow on Instagram</a>
          <a href="/contact" class="btn btn-outline" style="border-color:rgba(255,255,255,0.5); color:#fff;">Free Estimate</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
