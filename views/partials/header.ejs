<div class="top-bar">
  <div class="container">
    <div class="top-bar-left">
      <span><%= site.license %></span>
      <a href="/contact">738 S Waterman Ave C45, San Bernardino, CA 92408</a>
    </div>
    <div class="top-bar-social">
      <a href="<%= site.social.google %>" target="_blank" rel="noopener">Google Reviews</a>
      <a href="<%= site.social.yelp %>" target="_blank" rel="noopener">Yelp</a>
      <a href="<%= site.social.instagram %>" target="_blank" rel="noopener">Instagram</a>
      <a href="<%= site.social.facebook %>" target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container">
    <a href="/" class="brand" aria-label="<%= site.shortName %> home">
      <img src="/images/logo.png" alt="<%= site.shortName %> logo">
    </a>

    <nav class="main-nav" aria-label="Primary">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/services" class="<%= currentPath === '/services' ? 'active' : '' %>">Services</a>
      <a href="/gallery" class="<%= currentPath === '/gallery' ? 'active' : '' %>">Gallery</a>
      <a href="/blog" class="<%= currentPath.startsWith('/blog') ? 'active' : '' %>">Blog</a>
      <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">Our Story</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
    </nav>

    <div class="header-actions">
      <a href="/contact" class="btn btn-secondary">Book Free Estimate</a>
      <a href="<%= site.phoneHref %>" class="btn-call">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="call-label"><%= site.phone %><small>24/7 Emergency — Call Now</small></span>
      </a>
    </div>

    <button class="nav-toggle" aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<div class="mobile-nav" aria-hidden="true">
  <div class="mobile-nav-top">
    <img src="/images/logo.png" alt="<%= site.shortName %> logo">
    <button class="mobile-nav-close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <nav class="mobile-nav-links" aria-label="Mobile">
    <a href="/">Home</a>
    <a href="/services">Services</a>
    <a href="/gallery">Photo Gallery</a>
    <a href="/blog">Blog</a>
    <a href="/about">Our Story</a>
    <a href="/contact">Contact</a>
  </nav>
  <div class="mobile-nav-cta">
    <a href="<%= site.phoneHref %>" class="btn btn-primary btn-block">Call <%= site.phone %></a>
    <a href="/contact" class="btn btn-secondary btn-block">Book a Free Estimate</a>
  </div>
</div>

<div class="mobile-call-bar">
  <a href="<%= site.phoneHref %>">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    24/7 Emergency — Call <%= site.phone %>
  </a>
</div>
